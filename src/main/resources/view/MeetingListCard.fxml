<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="5" minHeight="65" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="8" right="10" bottom="8" left="15" />
  </padding>
  <HBox alignment="CENTER_LEFT">
    <Label fx:id="id" minWidth="-Infinity" styleClass="cell_big_label" />
    <Label fx:id="name" wrapText="true" styleClass="cell_big_label" />
  </HBox>
  <Label fx:id="schedule" wrapText="true" styleClass="cell_small_label" />
</VBox>
