@startuml
!include style.puml
skinparam MinClassWidth 140
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam nodesep 200
skinparam ranksep 200

Package Model as ModelPackage <<Rectangle>> {
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Name
Class Phone
Class Email
Class Address
Class MeetingList
Class Meeting
Class MeetingName
Class MeetingTime
Class MeetingDate
Class Tag
}


AddressBook .[norank].|> ReadOnlyAddressBook
ModelManager .[norank].|> Model
Model .[norank].> ReadOnlyAddressBook
Model .[norank].> ReadOnlyUserPrefs
ModelManager -[norank]-> "1" AddressBook
ModelManager -[norank]-> "1" UserPrefs
UserPrefs .[norank].|> ReadOnlyUserPrefs

AddressBook *-[norank]-> "1" UniquePersonList
UniquePersonList -[norank]-> "~* all" Person
AddressBook *-[norank]-> "1" MeetingList
MeetingList -[norank]-> "~* all" Meeting
Person *-down-> "1" Name
Person *-down-> "1" Phone
Person *-down-> "1" Email
Person *-down-> "1" Address
Person -[norank]-> "*" Tag
Meeting *-down-> "1" MeetingName
Meeting *-right-> "1" MeetingDate
Meeting *-down-> "1\nstartTime" MeetingTime
Meeting *-down-> "1\nendTime" MeetingTime
Meeting -right-> "*" Tag
ModelManager -[norank]-> "~* filteredMeetings" Meeting
ModelManager -[norank]-> "~* sortedMeetings" Meeting
ModelManager -[norank]-> "* filteredPersons" Person


' Invisible links arrange classes without adding model relationships.
ReadOnlyAddressBook -[hidden]right-> Model
Model -[hidden]right-> ReadOnlyUserPrefs
ReadOnlyAddressBook -[hidden]down-> AddressBook
ReadOnlyUserPrefs -[hidden]down-> UserPrefs
AddressBook -[hidden]right-> UserPrefs
AddressBook -[hidden]down-> ModelManager
UniquePersonList -[hidden]right-> ModelManager
ModelManager -[hidden]right-> MeetingList
UniquePersonList -[hidden]down-> Person
MeetingList -[hidden]left-> Meeting
Person -[hidden]right-> Meeting
Person -[hidden]down-> Name
Person -[hidden]down-> Phone
Person -[hidden]down-> Email
Person -[hidden]down-> Address
Meeting -[hidden]down-> MeetingName
Meeting -[hidden]down-> MeetingTime
'Meeting -[hidden]down-> MeetingDate
ModelManager -[hidden]down-> Tag
Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Address
Address -[hidden]right-> Tag
Tag -[hidden]right-> MeetingName
MeetingName -[hidden]right-> MeetingTime
'MeetingTime -[hidden]right-> MeetingDate
@enduml
